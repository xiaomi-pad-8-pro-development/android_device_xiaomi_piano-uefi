diff --git a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
index 0c05ffa3..53572405 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
+++ b/Silicon/Silicium/SiliciumPkg/Sec/AArch64/ModuleEntryPoint.S
@@ -13,6 +13,13 @@
 .set CTRL_SPAN_BIT, BIT23
 
 ASM_FUNC (_ModuleEntryPoint)
+  // Keep x0, x2 and x3 for the platform: the address of the DT a
+  // Linux-style boot loader hands over, and the payload BootShim carries
+  // (address, size). The slots are in this section, which is in RAM here.
+  adr   x1, ASM_PFX (gSecEntryArgs)
+  stp   x0, x2, [x1]
+  str   x3, [x1, #16]
+
   // Do Platform Specific Initialization
   bl    ASM_PFX (PlatformAssemblyInitialize)
 
@@ -61,3 +68,9 @@ ASM_PFX (MainEntryPoint):
 
   // Do Infinite Spin
   b     .
+
+  // x0, x2 and x3 of the previous stage, written once at entry
+  .align 3
+  .global ASM_PFX (gSecEntryArgs)
+ASM_PFX (gSecEntryArgs):
+  .quad 0, 0, 0
diff --git a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
index 8d586b35..0189bc6f 100644
--- a/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
+++ b/Silicon/Silicium/SiliciumPkg/Sec/Sec.c
@@ -18,6 +18,9 @@
 
 #include "Sec.h"
 
+// x0, x2 and x3 of the previous stage, saved by ModuleEntryPoint.S
+extern UINT64  gSecEntryArgs[3];
+
 #ifndef MDEPKG_NDEBUG
 STATIC
 VOID
@@ -130,6 +133,11 @@ SecMain (VOID)
     return;
   }
 
+  // Pass on what the previous stage handed over in x0 (a DT address for a
+  // Linux-style boot loader), then x2 and x3 (an embedded payload), so DXE
+  // drivers can use them. The first UINT64 stays x0.
+  BuildGuidDataHob (&gSiliciumEntryArgHobGuid, gSecEntryArgs, sizeof (gSecEntryArgs));
+
   // Run Library Cconstructors
   ProcessLibraryConstructorList ();
 
