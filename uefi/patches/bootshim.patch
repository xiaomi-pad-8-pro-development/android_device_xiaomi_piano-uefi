diff --git a/BootShim/BootShim.S b/BootShim/BootShim.S
index 4d208553..23393211 100644
--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -1,3 +1,7 @@
+#ifndef EMBEDDED_PAYLOAD_SIZE
+#define EMBEDDED_PAYLOAD_SIZE 0
+#endif
+
 _Head:
   adr   x1, _Payload    /* Set _Entry address */
   b     _Start          /* Jump to the real code */
@@ -7,7 +11,7 @@ _StackBase:
   .quad FD_BASE         /* Text Offset */
 
 _StackSize:
-  .quad FD_SIZE         /* Image Size */
+  .quad FD_SIZE + (_Payload - _Head) + EMBEDDED_PAYLOAD_SIZE /* Shim, firmware and payload */
   .quad 0               /* Flags */
   .quad 0               /* Reserved */
   .quad 0               /* Reserved */
@@ -31,12 +35,42 @@ _CopyLoop:
   ldr   x5, =FD_BASE
 
 _Entry:
+  /* Publish the copied instructions before executing them. */
+  dsb   sy
+  mrs   x9, ctr_el0
+  ubfx  x9, x9, #16, #4
+  mov   x10, #4
+  lsl   x9, x10, x9
+  sub   x10, x9, #1
+  bic   x8, x5, x10
+  ldr   x7, =FD_SIZE
+  add   x7, x5, x7
+
+_CleanLoop:
+  dc    cvac, x8
+  add   x8, x8, x9
+  cmp   x8, x7
+  b.lo  _CleanLoop
+  dsb   sy
+  ic    iallu
+  dsb   sy
+  isb
+
+  /* x2 and x3: the payload after the firmware volume, left in place. */
+  mov   x2, xzr
+  mov   x3, xzr
+#if EMBEDDED_PAYLOAD_SIZE > 0
+  ldr   x2, =FD_SIZE
+  add   x2, x1, x2
+  ldr   x3, =EMBEDDED_PAYLOAD_SIZE
+#endif
   br    x5
 
 _Dead:
   b     _Dead
 
 .text
+.ltorg
 .align 4
 
 _Payload:
